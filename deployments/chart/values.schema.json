{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/caas-team/GoKubeDownscaler/deployments/chart/values.schema.json",
  "title": "go-kube-downscaler Helm values",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
	"stringMap": {
	  "type": "object",
	  "additionalProperties": { "type": "string" }
	},
	"probe": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"enabled": { "type": "boolean" },
		"failureThreshold": { "type": "integer", "minimum": 1 },
		"initialDelaySeconds": { "type": "integer", "minimum": 0 },
		"periodSeconds": { "type": "integer", "minimum": 1 },
		"timeoutSeconds": { "type": "integer", "minimum": 1 },
		"successThreshold": { "type": "integer", "minimum": 1 }
	  },
	  "required": [
		"enabled",
		"failureThreshold",
		"initialDelaySeconds",
		"periodSeconds",
		"timeoutSeconds",
		"successThreshold"
	  ]
	},
	"image": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"repository": { "type": "string" },
		"pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
		"tag": { "type": "string" },
		"digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" }
	  },
	  "required": ["repository", "pullPolicy", "tag"]
	},
	"resources": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"limits": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"cpu": { "type": "string" },
			"memory": { "type": "string" }
		  }
		},
		"requests": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"cpu": { "type": "string" },
			"memory": { "type": "string" }
		  }
		}
	  }
	},
	"envVar": {
	  "type": "object",
	  "additionalProperties": true,
	  "properties": {
		"name": { "type": "string" },
		"value": { "type": "string" },
		"valueFrom": { "type": "object", "additionalProperties": true }
	  },
	  "required": ["name"]
	},
	"imagePullSecret": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"name": { "type": "string" }
	  },
	  "required": ["name"]
	},
	"toleration": { "type": "object", "additionalProperties": true },
	"affinity": { "type": "object", "additionalProperties": true },
	"secretTemplate": { "type": "object", "additionalProperties": true },
	"podDisruptionBudgetValue": {
	  "oneOf": [
		{ "type": "integer", "minimum": 0 },
		{ "type": "string", "pattern": "^(|[0-9]+%?)$" }
	  ]
	},
	"podDisruptionBudget": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"enabled": { "type": "boolean" },
		"minAvailable": { "$ref": "#/$defs/podDisruptionBudgetValue" },
		"maxUnavailable": { "$ref": "#/$defs/podDisruptionBudgetValue" },
		"unhealthyPodEvictionPolicy": { "type": "string", "enum": ["IfHealthyBudget", "AlwaysAllow"] }
	  },
	  "not": {
		"allOf": [
		  {
			"required": ["minAvailable"],
			"properties": {
			  "minAvailable": {
				"not": { "const": "" }
			  }
			}
		  },
		  {
			"required": ["maxUnavailable"],
			"properties": {
			  "maxUnavailable": {
				"not": { "const": "" }
			  }
			}
		  }
		]
	  }
	},
	"monitor": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"enabled": { "type": "boolean" },
		"namespace": { "type": "string" },
		"interval": { "type": "string", "pattern": "^([0-9]+(ms|s|m|h))*$" },
		"scrapeTimeout": { "type": "string", "pattern": "^([0-9]+(ms|s|m|h))*$" },
		"additionalLabels": { "$ref": "#/$defs/stringMap" },
		"relabelings": {
		  "type": "array",
		  "items": { "type": "object", "additionalProperties": true }
		},
		"metricRelabelings": {
		  "type": "array",
		  "items": { "type": "object", "additionalProperties": true }
		}
	  },
	  "required": ["enabled"]
	}
  },
  "properties": {
	"replicaCount": { "type": "integer", "minimum": 0 },
	"image": { "$ref": "#/$defs/image" },
	"imagePullSecrets": {
	  "type": "array",
	  "items": { "$ref": "#/$defs/imagePullSecret" }
	},
	"arguments": {
	  "type": ["array", "null"],
	  "items": { "type": "string" }
	},
	"extraArguments": {
	  "type": ["array", "null"],
	  "items": { "type": "string" }
	},
	"includedResources": {
	  "type": "array",
	  "items": {
		"type": "string",
		"enum": [
		  "deployments",
		  "statefulsets",
		  "daemonsets",
		  "rollouts",
		  "horizontalpodautoscalers",
		  "jobs",
		  "cronjobs",
		  "scaledobjects",
		  "stacks",
		  "prometheuses",
		  "poddisruptionbudgets",
		  "autoscalingrunnersets",
		  "postgresqls",
		  "kafkaconnects",
		  "kafkamirrormaker2s",
		  "kafkabridges",
		  "services",
		  "awselbservices",
		  "awsnlbservices",
		  "ingresses",
		  "gateways",
		  "rabbitmqclusters",
		  "cnpgclusters",
		  "elasticsearches",
		  "mongodbcommunities",
		  "redisreplications",
		  "redissentinels"
		]
	  }
	},
	"fullnameOverride": { "type": "string" },
	"nameOverride": { "type": "string" },
	"constrainedNamespaces": {
	  "type": "array",
	  "items": { "type": "string" }
	},
	"serviceAccount": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"create": { "type": "boolean" },
		"annotations": { "$ref": "#/$defs/stringMap" },
		"name": { "type": "string" },
		"automountServiceAccountToken": { "type": "boolean" }
	  },
	  "required": ["create", "annotations", "name"]
	},
	"priorityClassName": { "type": "string" },
	"podSecurityContext": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"runAsGroup": { "type": "integer" },
		"runAsNonRoot": { "type": "boolean" },
		"runAsUser": { "type": "integer" },
		"fsGroup": { "type": "integer" },
		"supplementalGroups": {
		  "type": "array",
		  "items": { "type": "integer" }
		},
		"seccompProfile": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"type": { "type": "string", "enum": ["RuntimeDefault", "Localhost", "Unconfined"] },
			"localhostProfile": { "type": "string" }
		  },
		  "required": ["type"]
		}
	  },
	  "required": ["runAsGroup", "runAsNonRoot", "runAsUser", "fsGroup", "supplementalGroups"]
	},
	"securityContext": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"readOnlyRootFilesystem": { "type": "boolean" },
		"allowPrivilegeEscalation": { "type": "boolean" },
		"privileged": { "type": "boolean" },
		"capabilities": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"drop": {
			  "type": "array",
			  "items": { "type": "string" }
			}
		  },
		  "required": ["drop"]
		}
	  },
	  "required": ["readOnlyRootFilesystem", "allowPrivilegeEscalation", "privileged", "capabilities"]
	},
	"healthProbes": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"readinessProbe": { "$ref": "#/$defs/probe" },
		"livenessProbe": { "$ref": "#/$defs/probe" },
		"startupProbe": { "$ref": "#/$defs/probe" },
		"livenessStaleAfter": { "type": "string", "pattern": "^([0-9]+(ms|s|m|h))*$" }
	  },
	  "required": ["readinessProbe", "livenessProbe", "startupProbe"]
	},
	"resources": { "$ref": "#/$defs/resources" },
	"podAnnotations": { "$ref": "#/$defs/stringMap" },
	"podLabels": { "$ref": "#/$defs/stringMap" },
	"extraEnv": {
	  "type": "array",
	  "items": { "$ref": "#/$defs/envVar" }
	},
	"nodeSelector": { "$ref": "#/$defs/stringMap" },
	"tolerations": {
	  "type": "array",
	  "items": { "$ref": "#/$defs/toleration" }
	},
	"affinity": { "$ref": "#/$defs/affinity" },
	"excludedNamespaces": {
	  "type": "array",
	  "items": { "type": "string" }
	},
	"configMap": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"name": { "type": "string" },
		"extraConfig": { "type": "string" }
	  },
	  "required": ["name", "extraConfig"]
	},
	"forceRestartOnConfigChange": { "type": "boolean" },
	"podDisruptionBudget": { "$ref": "#/$defs/podDisruptionBudget" },
	"deployExtraResources": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"gatewayClass": { "type": "boolean" },
		"ingressClass": { "type": "boolean" }
	  },
	  "required": ["gatewayClass", "ingressClass"]
	},
	"annotationsCompliance": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"mutateUnauthorizedAnnotationsAddition": { "type": "boolean" },
		"failurePolicy": { "type": "string", "enum": ["Fail", "Ignore"] },
		"validationActions": {
		  "type": "array",
		  "minItems": 1,
		  "maxItems": 3,
		  "uniqueItems": true,
		  "items": { "type": "string", "enum": ["Audit", "Warn", "Deny"] }
		},
		"authorizedNamespacesToServiceAccountsRegex": { "$ref": "#/$defs/stringMap" },
		"authorizedUsersRegex": {
		  "type": "array",
		  "maxItems": 60,
		  "uniqueItems": true,
		  "items": { "type": "string" }
		},
		"authorizedGroupsRegex": {
		  "type": "array",
		  "maxItems": 60,
		  "uniqueItems": true,
		  "items": { "type": "string" }
		},
		"onWorkloads": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"enabled": { "type": "boolean" },
			"preventRemoval": { "type": "boolean" }
		  },
		  "required": ["enabled", "preventRemoval"]
		},
		"onNamespace": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"enabled": { "type": "boolean" },
			"preventRemoval": { "type": "boolean" }
		  },
		  "required": ["enabled", "preventRemoval"]
		}
	  },
	  "required": [
		"mutateUnauthorizedAnnotationsAddition",
		"validationActions",
		"authorizedNamespacesToServiceAccountsRegex",
		"authorizedUsersRegex",
		"authorizedGroupsRegex",
		"onWorkloads",
		"onNamespace"
	  ]
	},
	"webhookController": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"enabled": { "type": "boolean" },
		"image": { "$ref": "#/$defs/image" },
		"replicaCount": { "type": "integer", "minimum": 0 },
		"priorityClassName": { "type": "string" },
		"serviceAccount": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"create": { "type": "boolean" },
			"annotations": { "$ref": "#/$defs/stringMap" },
			"name": { "type": "string" }
		  },
		  "required": ["create", "annotations", "name"]
		},
		"extraArguments": {
		  "type": ["array", "null"],
		  "items": { "type": "string" }
		},
		"imagePullSecrets": {
		  "type": "array",
		  "items": { "$ref": "#/$defs/imagePullSecret" }
		},
		"podAnnotations": { "$ref": "#/$defs/stringMap" },
		"podLabels": { "$ref": "#/$defs/stringMap" },
		"extraEnv": {
		  "type": "array",
		  "items": { "$ref": "#/$defs/envVar" }
		},
		"healthProbes": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"readinessProbe": { "$ref": "#/$defs/probe" },
			"livenessProbe": { "$ref": "#/$defs/probe" },
			"startupProbe": { "$ref": "#/$defs/probe" }
		  },
		  "required": ["readinessProbe", "livenessProbe", "startupProbe"]
		},
		"resources": { "$ref": "#/$defs/resources" },
		"securityContext": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"readOnlyRootFilesystem": { "type": "boolean" },
			"allowPrivilegeEscalation": { "type": "boolean" },
			"privileged": { "type": "boolean" },
			"capabilities": {
			  "type": "object",
			  "additionalProperties": false,
			  "properties": {
				"drop": {
				  "type": "array",
				  "items": { "type": "string" }
				}
			  },
			  "required": ["drop"]
			}
		  },
		  "required": ["readOnlyRootFilesystem", "allowPrivilegeEscalation", "privileged", "capabilities"]
		},
		"nodeSelector": { "$ref": "#/$defs/stringMap" },
		"tolerations": {
		  "type": "array",
		  "items": { "$ref": "#/$defs/toleration" }
		},
		"affinity": { "$ref": "#/$defs/affinity" },
		"mutatingWebhookConfiguration": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 30 },
			"failurePolicy": { "type": "string", "enum": ["Ignore", "Fail"] }
		  },
		  "required": ["timeoutSeconds", "failurePolicy"]
		},
		"podDisruptionBudget": { "$ref": "#/$defs/podDisruptionBudget" },
		"clusterDomain": { "type": "string" },
		"certManager": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"enabled": { "type": "boolean" },
			"duration": { "type": "string" },
			"renewBefore": { "type": "string" },
			"secretTemplate": { "$ref": "#/$defs/secretTemplate" },
			"ca": {
			  "type": "object",
			  "additionalProperties": false,
			  "properties": {
				"generate": { "type": "boolean" },
				"secretName": { "type": "string" }
			  },
			  "required": ["generate", "secretName"]
			},
			"issuer": {
			  "type": "object",
			  "additionalProperties": false,
			  "properties": {
				"generate": { "type": "boolean" },
				"name": { "type": "string" },
				"kind": { "type": "string" },
				"group": { "type": "string" }
			  },
			  "required": ["generate", "name", "kind", "group"]
			}
		  },
		  "required": ["enabled", "duration", "renewBefore", "secretTemplate", "ca", "issuer"]
		},
		"podMonitor": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"enabled": { "type": "boolean" },
			"interval": { "type": "string" },
			"scrapeTimeout": { "type": "string" },
			"namespace": { "type": "string" },
			"additionalLabels": { "$ref": "#/$defs/stringMap" },
			"relabelings": {
			  "type": "array",
			  "items": { "type": "object", "additionalProperties": true }
			},
			"metricRelabelings": {
			  "type": "array",
			  "items": { "type": "object", "additionalProperties": true }
			}
		  },
		  "required": [
			"enabled",
			"interval",
			"scrapeTimeout",
			"namespace",
			"additionalLabels",
			"relabelings",
			"metricRelabelings"
		  ]
		}
	  },
	  "required": [
		"enabled",
		"image",
		"replicaCount",
		"priorityClassName",
		"serviceAccount",
		"podAnnotations",
		"podLabels",
		"extraEnv",
		"healthProbes",
		"resources",
		"securityContext",
		"nodeSelector",
		"tolerations",
		"affinity",
		"mutatingWebhookConfiguration",
		"podDisruptionBudget",
		"clusterDomain",
		"certManager",
		"podMonitor"
	  ]
	},
	"podMonitor": { "$ref": "#/$defs/monitor" },
	"metrics": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"enabled": { "type": "boolean" },
		"service": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"enabled": { "type": "boolean" },
			"annotations": { "$ref": "#/$defs/stringMap" }
		  },
		  "required": ["enabled"]
		}
	  },
	  "required": ["enabled"]
	},
	"commonLabels": { "$ref": "#/$defs/stringMap" },
	"revisionHistoryLimit": { "type": "integer", "minimum": 0 },
	"updateStrategy": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"type": { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
		"rollingUpdate": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"maxSurge": {
			  "oneOf": [
				{ "type": "integer", "minimum": 0 },
				{ "type": "string", "pattern": "^[0-9]+%$" }
			  ]
			},
			"maxUnavailable": {
			  "oneOf": [
				{ "type": "integer", "minimum": 0 },
				{ "type": "string", "pattern": "^[0-9]+%$" }
			  ]
			}
		  }
		}
	  }
	},
	"terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
	"topologySpreadConstraints": {
	  "type": "array",
	  "items": { "type": "object", "additionalProperties": true }
	},
	"port": {
	  "type": "integer",
	  "minimum": 1024,
	  "maximum": 65535,
	  "description": "Unprivileged port, so the non-root container needs no capabilities"
	},
	"logging": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"json": { "type": "boolean" },
		"debug": { "type": "boolean" }
	  },
	  "required": ["json", "debug"]
	},
	"networkPolicy": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"enabled": { "type": "boolean" },
		"apiServer": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"ports": {
			  "type": "array",
			  "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
			  "minItems": 1
			},
			"cidrs": {
			  "type": "array",
			  "items": { "type": "string" },
			  "minItems": 1
			}
		  },
		  "required": ["ports", "cidrs"]
		},
		"dns": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"namespaceSelector": { "$ref": "#/$defs/stringMap" },
			"podSelector": { "$ref": "#/$defs/stringMap" }
		  },
		  "required": ["namespaceSelector", "podSelector"]
		},
		"metricsFrom": {
		  "type": "array",
		  "items": { "type": "object", "additionalProperties": true }
		},
		"extraEgress": {
		  "type": "array",
		  "items": { "type": "object", "additionalProperties": true }
		}
	  },
	  "required": ["enabled"]
	},
	"serviceMonitor": { "$ref": "#/$defs/monitor" },
	"prometheusRule": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"enabled": { "type": "boolean" },
		"namespace": { "type": "string" },
		"additionalLabels": { "$ref": "#/$defs/stringMap" },
		"cycleStaleFor": { "type": "string", "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$" },
		"severity": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"critical": { "type": "string" },
			"warning": { "type": "string" }
		  },
		  "required": ["critical", "warning"]
		},
		"additionalRules": {
		  "type": "array",
		  "items": { "type": "object", "additionalProperties": true }
		}
	  },
	  "required": ["enabled"]
	},
	"tracing": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"enabled": { "type": "boolean" },
		"endpoint": { "type": "string" },
		"insecure": { "type": "boolean" },
		"serviceName": { "type": "string" },
		"sampler": {
		  "type": "string",
		  "enum": [
			"always_on",
			"always_off",
			"traceidratio",
			"parentbased_always_on",
			"parentbased_always_off",
			"parentbased_traceidratio"
		  ]
		},
		"samplerArg": { "type": "string" },
		"resourceAttributes": { "$ref": "#/$defs/stringMap" },
		"collector": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"namespaceSelector": { "$ref": "#/$defs/stringMap" },
			"podSelector": { "$ref": "#/$defs/stringMap" },
			"port": { "type": "integer", "minimum": 1, "maximum": 65535 }
		  }
		}
	  },
	  "required": ["enabled"]
	}
  },
  "required": []
}
